{
  "name": "mis-carguitas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "next typegen && vp check && vp test && node scripts/check-migrations.mjs",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "typecheck": "next typegen && vp check --no-fmt --no-lint",
    "test": "vp test",
    "test:watch": "vp test watch",
    "db:keys": "node scripts/gen-signing-key.mjs",
    "db:start": "npm run db:keys && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "db:check-migrations": "node scripts/check-migrations.mjs",
    "gh:issues": "node scripts/gh-issues.mjs",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vite-plus": "1.5.1"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
