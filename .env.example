# Copy to .env.local. Values for local dev come from `npm run db:start`.
# All server-only: the browser never talks to Supabase directly (docs/SECURITY.md §2).

SUPABASE_URL=http://127.0.0.1:54321
# "Publishable key" printed by `supabase start` (sb_publishable_...). Never the secret/service key.
SUPABASE_PUBLISHABLE_KEY=
SITE_URL=http://localhost:3000
